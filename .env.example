# Für die App (Vercel: Settings → Environment Variables). Ohne diese Werte läuft die App im Demo-Modus.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# Nur für das Import-Skript, NIE in Vercel eintragen oder committen.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
